# Copy this file to .env and fill in the values below.
# This file is duplicated in apps/web, apps/api, and packages/db since each
# reads its own .env from its own working directory.

# =====================================================================
# Database
# =====================================================================

# Matches the local Postgres container started by `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/zemio"

# Optional: direct (non-pooled) connection used by Prisma migrations.
# Falls back to DATABASE_URL when unset.
DIRECT_URL=

# =====================================================================
# Runtime
# =====================================================================

NODE_ENV=development

# Base URL of this app
BETTER_AUTH_URL="http://localhost:3000"

# URL of the internal Hono API server (apps/api)
API_URL="http://localhost:3001"

# Secret key for signing authentication tokens. Optional in development,
# required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Shared secret for service-to-service auth between web and apps/api
# (min 32 chars). Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=

# Secret key for encrypting banking details.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# =====================================================================
# Microsoft OAuth
# =====================================================================
# From Azure AD App Registration > Certificates & secrets

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# =====================================================================
# Storage (S3-compatible)
# =====================================================================

STORAGE_HOST=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY=
STORAGE_SECURE=true
STORAGE_FORCE_PATH_STYLE=false

# =====================================================================
# Email (Resend)
# =====================================================================

# From https://resend.com/api-keys
RESEND_API_KEY=

# Optional override for the "from" address on outgoing emails
EMAIL_FROM=

# =====================================================================
# Optional overrides
# =====================================================================

SUPERUSER_ID=

# =====================================================================
# Better Stack (optional — error tracking & logging)
# =====================================================================

BETTER_STACK_DSN=
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=

# Build-time only — used by the Sentry webpack plugin to upload source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# =====================================================================
# Local development tuning (optional)
# =====================================================================

# Caps Turbopack's memory use, in megabytes (positive integer). Leave unset
# unless the dev server outgrows a memory-constrained machine.
TURBOPACK_MEMORY_LIMIT_MB=
