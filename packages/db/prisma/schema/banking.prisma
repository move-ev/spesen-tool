// Banking details; iban and fullName are stored encrypted (AES-256-GCM)

model BankingDetails {
  id    String @id @default(cuid())
  // Used for displaying the banking details in the UI without exposing the iban
  title String

  iban     String
  fullName String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@index([userId])
  @@map("banking_details")
}

// Immutable copy of the banking details a report was submitted with.
// Written (upserted) when the report transitions to PENDING_APPROVAL, so
// later edits or deletion of the live BankingDetails cannot change what
// reviewers and PDF exports see. Ciphertext is copied as-is (same key).
model ReportBankingSnapshot {
  id       String @id @default(cuid())
  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  iban     String
  fullName String

  createdAt DateTime @default(now())

  @@map("report_banking_snapshot")
}
