// Legal release acceptance tracking (hard gate for protectedProcedure)

model LegalAcceptance {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseVersion   String
  acceptanceType   LegalAcceptanceType
  acceptedAt       DateTime            @default(now())
  documentVersions Json

  // One acceptance row per user/release is intentional. Repeated submissions for
  // the same release are treated as idempotent confirmations, not append-only events.
  @@unique([userId, releaseVersion])
  @@index([releaseVersion])
  @@map("legal_acceptance")
}

enum LegalAcceptanceType {
  CHECKBOX_AND_BUTTON
  IMPLICIT_ON_SIGNUP
}
