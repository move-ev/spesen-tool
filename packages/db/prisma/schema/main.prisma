// Prisma schema for Zemio, split into domain files (see sibling *.prisma files).
// learn more: https://www.prisma.io/docs/orm/prisma-schema/overview/location#multi-file-prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
