// Cost units and their grouping, unique per organization + tag

model CostUnitGroup {
  id             String       @id @default(cuid())
  title          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costUnits      CostUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([organizationId, title])
  @@index([organizationId])
  @@map("cost_unit_group")
}

enum CostUnitStatus {
  ACTIVE
  ARCHIVED
}

enum CostUnitColor {
  RED
  ORANGE
  AMBER
  YELLOW
  LIME
  GREEN
  EMERALD
  TEAL
  CYAN
  SKY
  BLUE
  INDIGO
  VIOLET
  PURPLE
  FUCHSIA
  PINK
  ROSE
  BASE
}

model CostUnit {
  id             String       @id @default(cuid())
  tag            String
  title          String
  examples       String[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status CostUnitStatus @default(ACTIVE)
  color  CostUnitColor  @default(BASE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costUnitGroupId String?
  costUnitGroup   CostUnitGroup? @relation(fields: [costUnitGroupId], references: [id], onDelete: Cascade)

  reports Report[]

  @@unique([organizationId, tag])
  @@index([organizationId])
  @@index([tag])
  @@map("cost_unit")
}
