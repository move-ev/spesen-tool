// Multi-tenancy models, managed by the better-auth organization plugin

model Organization {
  id                String   @id
  name              String
  slug              String   @unique
  logo              String?
  metadata          String?
  createdAt         DateTime
  microsoftTenantId String?

  // Last Report.tag issued to this organization. Incremented atomically when
  // a report is created, which is what makes report numbers per-org.
  reportCounter Int @default(0)

  members     Member[]
  invitations Invitation[]

  reports        Report[]
  costUnits      CostUnit[]
  costUnitGroups CostUnitGroup[]
  settings       Settings?
  auditEvents    AuditEvent[]

  @@map("organization")
}

model Member {
  id             String   @id
  userId         String
  organizationId String
  role           String
  createdAt      DateTime

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A user can only be a member of an organization once. The session-create
  // hook's check-then-insert is not transactional; this constraint is the
  // real guard against duplicates from concurrent logins.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String   @id
  email          String
  inviterId      String
  organizationId String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime

  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("invitation")
}
